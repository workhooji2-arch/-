generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TA
}

model User {
  id            String        @id @default(cuid())
  username      String        @unique
  passwordHash  String
  role          Role          @default(TA)
  name          String
  wage          Int?
  memo          String?
  currentClockIn DateTime?
  createdAt     DateTime      @default(now())
  sessions      WorkSession[]
}

model WorkSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  startTime String
  endTime   String
  hours     Float
  wage      Int
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}
