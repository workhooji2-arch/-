generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TA
}

model User {
  id            String        @id @default(cuid())
  username      String        @unique
  passwordHash  String
  role          Role          @default(TA)
  name          String
  memo          String?
  currentClockIn DateTime?
  /// 출근 버튼을 누를 때 고른 시급 업무. 퇴근할 때 그 단가로 기록된다.
  currentTaskId String?
  createdAt     DateTime      @default(now())
  /// Sessions issued before this moment are refused, so changing a password
  /// (or an admin resetting one) signs out anyone else already logged in.
  credentialsChangedAt DateTime @default(now())
  sessions      WorkSession[]
  reimbursements Reimbursement[]
  unitWorks     UnitWork[]
  unitTasks     UnitTask[]
  hourlyTasks   HourlyTask[]
}

/// 시간제 업무 한 종류와 그 시급. 같은 조교라도 무슨 일을 하느냐에 따라
/// 시급이 다르므로 여러 개를 가질 수 있다.
model HourlyTask {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  rate      Int
  createdAt DateTime      @default(now())
  sessions  WorkSession[]

  @@unique([userId, label])
  @@index([userId])
}

/// 개수제 업무 한 종류와 그 단가. 업무마다 단가가 다르므로 조교 한 명이
/// 여러 개를 가질 수 있다.
model UnitTask {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  rate      Int
  createdAt DateTime   @default(now())
  works     UnitWork[]

  @@unique([userId, label])
  @@index([userId])
}

/// 개수제 작업 한 건. 업무명과 단가를 기록 시점 값으로 함께 저장해, 나중에
/// 단가를 바꾸거나 업무를 지워도 이미 기록된 금액이 흔들리지 않게 한다.
model UnitWork {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      UnitTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  label     String    @default("개수 작업")
  date      String
  quantity  Int
  rate      Int
  note      String?
  createdAt DateTime  @default(now())

  @@index([userId, date])
}

/// 관리자가 그 달에 쓸 수 있는 예산. 달마다 금액이 다르므로 월(YYYY-MM)을
/// 키로 두고, 조교 인건비를 빼고 얼마가 남는지 계산하는 데 쓴다.
model MonthlyBudget {
  month     String   @id
  amount    Int
  updatedAt DateTime @updatedAt
}

/// 조교가 자기 돈으로 먼저 결제한 비품비·심부름 비용. 근로 소득이 아니라
/// 실비 정산이므로 원천징수 없이 전액 지급된다.
model Reimbursement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  amount    Int
  note      String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WorkSession {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      HourlyTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// 기록 시점의 업무명. 업무를 지워도 지난 기록은 그대로 남는다.
  label     String      @default("근무")
  date      String
  startTime String
  endTime   String
  hours     Float
  wage      Int
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}
